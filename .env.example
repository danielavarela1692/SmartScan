# Casilla de mail que recibe las facturas
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Proveedor de OCR para facturas escaneadas/foto. Opciones: azure, google, none
OCR_PROVIDER=none
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# CUIT receptor: fijo por cuenta, es el CUIT de nuestro propio cliente
CUIT_RECEPTOR=

# API propia (GrabacionDePedidos.API) para traer el catalogo de items de compra.
# Si se deja vacio, se usa el catalogo de prueba en EIFFEL_ITEMS_FIXTURE.
EIFFEL_API_BASE_URL=
EIFFEL_API_USERNAME=
EIFFEL_API_PASSWORD=
EIFFEL_ITEMS_FIXTURE=fixtures/items_catalog.example.json

# Donde se guardan los matcheos que una persona ya resolvio a mano
MATCH_STORE_PATH=data/learned_matches.json
