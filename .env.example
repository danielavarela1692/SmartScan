# Casilla de mail que recibe las facturas
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Proveedor de OCR para facturas escaneadas/foto. Opciones: azure, google, none
OCR_PROVIDER=none
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# CUIT receptor: fijo por cuenta, es el CUIT de nuestro propio cliente
CUIT_RECEPTOR=
